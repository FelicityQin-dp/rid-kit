{
    "name": "rid-lj4-lmp",
    "numb_walkers": 1,
    "numb_iters": 2,
    "trust_lvl_1": 2,
    "trust_lvl_2": 4,
    "init_models": [],

    "CV": {
        "mode": "custom",
        "angular_mask": [0, 0, 0, 0],
        "weights": [1, 1, 1, 1],
        "cv_file": ["colvar"]
    },

    "SelectorConfig": {
        "numb_cluster_lower": 2,
        "numb_cluster_upper": 4,
        "cluster_threshold": 0.5,
        "max_selection": 4,
        "numb_cluster_threshold": 3,
        "slice_mode": "dpdata",
        "type_map": ["Ar"]
    },

    "ExploreMDConfig": {
        "type": "lmp",
        "inputfile": "input_explore.lammps",
        "dt": 0.002,
        "output_freq": 50,
        "ntmpi": 1,
        "nt": 4,
        "max_warning": 2
    },

    "LabelMDConfig": {
        "type": "lmp",
        "method": "restrained",
        "inputfile": "input_label.lammps",
        "dt": 0.002,
        "output_freq": 50,
        "kappas": [500, 500, 500, 500],
        "std_threshold": 10.0,
        "ntmpi": 1,
        "nt": 4,
        "max_warning": 2
    },

    "Train": {
        "numb_models": 2,
        "neurons": [20, 20, 20],
        "resnet": true,
        "batch_size": 4,
        "epoches": 2000,
        "init_lr": 0.008,
        "decay_steps": 200,
        "decay_rate": 0.96,
        "train_thread": 4,
        "drop_out_rate": 0.2,
        "numb_threads": 4,
        "use_mix": false,
        "restart": false,
        "decay_steps_inner": 200
    }
}
